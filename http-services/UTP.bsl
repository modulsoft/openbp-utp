				   //|	СУММА(ЗапасыОстаткиИОбороты.СуммаОборот) КАК TurnoverAmount
	               |ИЗ
	               |	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Авто, , ) КАК ТоварыНаСкладахОстаткиИОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТоварыНаСкладахОстаткиИОбороты.Склад,
	               |	ТоварыНаСкладахОстаткиИОбороты.Номенклатура";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;

	ТЗ = РезультатЗапроса.Выгрузить();

	СтрCSV = СоздатьДанныеCSV(ТЗ, ";", Истина);
	Возврат СтрCSV;

