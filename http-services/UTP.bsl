Функция reportsCSVПолучитьДанные(Запрос)

	Перем Ответ;

	dateStart = Запрос.ПараметрыЗапроса.Получить("dateStart");
	dateEnd = Запрос.ПараметрыЗапроса.Получить("dateEnd");
	ТипОтчета = Запрос.ПараметрыЗапроса.Получить("type");
	ОрганизаияКод = Запрос.ПараметрыЗапроса.Получить("organization");

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		Если dateEnd = Неопределено Тогда
			Возврат СформироватьОтветДляHTTPСервиса(404, "date isn't provided");	
		КонецЕсли;

		СтрокаДляОтвета = "";

		НачалоПериода = НачалоДня(?(dateStart = Неопределено,Дата(1,1,1),Дата(dateStart)));
		КонецПериода = КонецДня(Дата(dateEnd));

		Если ТипОтчета = "Saldo" Тогда
			ОрганизаияUUID = Новый УникальныйИдентификатор(ОрганизаияКод);
			ОрганизацияСсылка = Справочники.Организации.ПолучитьСсылку(ОрганизаияUUID);
			Если ОрганизацияСсылка.ПолучитьОбъект() = Неопределено Тогда
				СформироватьОтветДляHTTPСервиса("404", "Організація не знайдена");
			КонецЕсли;
			СтрокаДляОтвета = СформироватьОтчетПоСальдо(НачалоПериода, КонецПериода, ОрганизацияСсылка);
		ИначеЕсли ТипОтчета = "PaymentTerms" Тогда
			СтрокаДляОтвета = СформироватьОтчетПоСтруктуреДебиторскойЗадолжености(КонецПериода);
		ИначеЕсли ТипОтчета = "CounterpartiesSettlements" Тогда
			СтрокаДляОтвета = СформироватьОтчетПоВзаиморасчетамСПокупателями(НачалоПериода, КонецПериода);
		ИначеЕсли ТипОтчета = "SuppliersSettlements" Тогда
			СтрокаДляОтвета = СформироватьОтчетПоВзаиморасчетамСПоставщиками(НачалоПериода, КонецПериода);
		ИначеЕсли ТипОтчета = "InventoryBalance" Тогда
			СтрокаДляОтвета = СформироватьОтчетПоЗапасамОстатки(НачалоПериода, КонецПериода);
		ИначеЕсли ТипОтчета = "InventoryTurnover" Тогда
			СтрокаДляОтвета = СформироватьОтчетПоЗапасамОбороты(НачалоПериода, КонецПериода);
		ИначеЕсли ТипОтчета = "Goods" Тогда
			СтрокаДляОтвета = СформироватьОтчетПоПартиямТоваров(НачалоПериода, КонецПериода);
		ИначеЕсли ТипОтчета = "Sales" Тогда
			СтрокаДляОтвета = СформироватьОтчетПоПродажам(НачалоПериода, КонецПериода);
		Иначе
			МассивДоступныхТипов = Новый Массив;
			МассивДоступныхТипов.Добавить("Saldo");
			МассивДоступныхТипов.Добавить("PaymentTerms");
			МассивДоступныхТипов.Добавить("CounterpartiesSettlements");
			МассивДоступныхТипов.Добавить("SuppliersSettlements");
			МассивДоступныхТипов.Добавить("InventoryBalance");
			МассивДоступныхТипов.Добавить("InventoryTurnover");
			МассивДоступныхТипов.Добавить("Goods");
			МассивДоступныхТипов.Добавить("Sales");

			СтрокаДляОтвета = ОбработкаJSON.ЗаписатьJSON_Обработка(МассивДоступныхТипов);
		КонецЕсли;

	Исключение
		Возврат СформироватьОтветДляHTTPСервиса(404, ОписаниеОшибки());
	КонецПопытки;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "text/csv;  charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	УстановитьПривилегированныйРежим(Ложь);

	Возврат ДобавитьЗаголовки(Ответ);
КонецФункции

Функция СоздатьЗаголовкиCSV(ТЗ, разделитель = ",")

	КолонкиТЗ = ТЗ.Колонки;
	стрКолонки = "";

	Для каждого Колонка Из КолонкиТЗ Цикл

		Если СтрДлина(стрКолонки) > 0 Тогда
			стрКолонки = стрКолонки + разделитель;
		КонецЕсли;    

		стрКолонки = стрКолонки + Колонка.Имя;

	КонецЦикла; 

	Возврат стрКолонки;

КонецФункции	

Функция СоздатьСтрокуCSV(записьТаблицаЗначений, разделитель)    

	стрЗапись = "";    

	Для каждого поле Из записьТаблицаЗначений Цикл

		Если СтрДлина(стрЗапись)>0 Тогда
			стрЗапись = стрЗапись + разделитель;
		КонецЕсли;    

		Если ТипЗнч(поле) = Тип("Число") Тогда
			стрПоле = ?(ЗначениеЗаполнено(поле),Формат(поле,"ЧРД=.; ЧГ=0"),"0");

		ИначеЕсли ТипЗнч(поле) = Тип("Дата") Тогда 
			стрПоле = Формат(поле,"ДФ=dd.MM.yyyy");

		Иначе //Если ТипЗнч(поле) = Тип("Строка") Тогда

			стрПоле = СтрЗаменить(Строка(поле),"""","""""");

			Если 
				(Найти(стрПоле," ")>0 ) ИЛИ (Найти(стрПоле,"""")>0) ИЛИ (Найти(стрПоле,",")>0 ) ИЛИ (Найти(стрПоле,";")>0 ) ИЛИ (Найти(стрПоле,Символы.Таб)>0)  ИЛИ (Найти(стрПоле,Символы.ВК)>0)   ИЛИ (Найти(стрПоле,Символы.ПФ)>0)   ИЛИ (Найти(стрПоле,Символы.ВТаб)>0) ИЛИ (Найти(стрПоле,Символы.НПП)>0)  ИЛИ (Найти(стрПоле,Символы.ПС)>0) 
			Тогда 
				стрПоле = """"+стрПоле+"""";
			КонецЕсли;    

		КонецЕсли;     

		стрЗапись = стрЗапись + Строка(стрПоле);

	КонецЦикла; 

	Возврат стрЗапись;

КонецФункции

Функция СоздатьДанныеCSV(таблицаЗначений, разделитель = ",", выводитьЗаголовок = ЛОЖЬ)

	текстЗапись="";

	Если выводитьЗаголовок Тогда
		текстЗапись=СоздатьЗаголовкиCSV(ТаблицаЗначений, разделитель);    
	КонецЕсли;

	Для Каждого запись Из таблицаЗначений Цикл

		стрЗапись = СоздатьСтрокуCSV(запись,разделитель);            
		Если СтрДлина(стрЗапись)>0 Тогда
			текстЗапись = текстЗапись +    Символы.ПС;
		КонецЕсли;    
		текстЗапись = текстЗапись + стрЗапись;

	КонецЦикла;        

	Возврат текстЗапись;

КонецФункции // СоздатьДанныеCSV()

Функция СформироватьОтчетПоСальдо(НачалоПериода, КонецПериода, Организация)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиИОбороты.Счет.Код КАК AccountCode,
	               |	ОстаткиИОбороты.Счет.Наименование КАК AccountName,
	               |	ОстаткиИОбороты.Валюта КАК Currency,
	               |	СУММА(ОстаткиИОбороты.СуммаНачальныйОстаток) КАК OpeningBalanceAmount,
	               |	СУММА(ОстаткиИОбороты.СуммаНачальныйОстатокДт) КАК OpeningBalanceDebitAmount,
	               |	СУММА(ОстаткиИОбороты.СуммаНачальныйОстатокКт) КАК OpeningBalanceCreditAmount,
	               |	СУММА(ОстаткиИОбороты.СуммаКонечныйОстаток) КАК ClosingBalanceAmount,
	               |	СУММА(ОстаткиИОбороты.СуммаКонечныйОстатокДт) КАК ClosingBalanceDebitAmount,
	               |	СУММА(ОстаткиИОбороты.СуммаКонечныйОстатокКт) КАК ClosingBalanceCreditAmount,
	               |	СУММА(ОстаткиИОбороты.СуммаОборот) КАК TurnoverAmount,
	               |	СУММА(ОстаткиИОбороты.СуммаОборотДт) КАК TurnoverDebitAmount,
	               |	СУММА(ОстаткиИОбороты.СуммаОборотКт) КАК TurnoverCreditAmount,
	               |	СУММА(ОстаткиИОбороты.ВалютнаяСуммаНачальныйОстаток) КАК OpeningBalanceAmountCurrency,
	               |	СУММА(ОстаткиИОбороты.ВалютнаяСуммаНачальныйОстатокДт) КАК OpeningBalanceDebitAmountCurrency,
	               |	СУММА(ОстаткиИОбороты.ВалютнаяСуммаНачальныйОстатокКт) КАК OpeningBalanceCreditAmountCurrency,
	               |	СУММА(ОстаткиИОбороты.ВалютнаяСуммаКонечныйОстаток) КАК ClosingBalanceAmountCurrency,
	               |	СУММА(ОстаткиИОбороты.ВалютнаяСуммаКонечныйОстатокДт) КАК ClosingBalanceDebitAmountCurrency,
	               |	СУММА(ОстаткиИОбороты.ВалютнаяСуммаКонечныйОстатокКт) КАК ClosingBalanceCreditAmountCurrency,
	               |	СУММА(ОстаткиИОбороты.ВалютнаяСуммаОборот) КАК TurnoverAmountCurrency,
	               |	СУММА(ОстаткиИОбороты.ВалютнаяСуммаОборотДт) КАК TurnoverDebitAmountCurrency,
	               |	СУММА(ОстаткиИОбороты.ВалютнаяСуммаОборотКт) КАК TurnoverCreditAmountCurrency
	               |ИЗ
	               |	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , , , Организация = &Организация) КАК ОстаткиИОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОстаткиИОбороты.Счет.Наименование,
	               |	ОстаткиИОбороты.Счет.Код,
	               |	ОстаткиИОбороты.Валюта";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Организация", Организация);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;

	ТЗ = РезультатЗапроса.Выгрузить();

	СтрCSV = СоздатьДанныеCSV(ТЗ, ";", Истина);
	Возврат СтрCSV;

КонецФункции

